# Copy to .env for local runs (outside docker). All values have defaults in core/settings.py.
HOST=0.0.0.0
PORT=8000
RELOAD=False
WORKERS=1
LOG_LEVEL=INFO

MONGO_URL=mongodb://localhost:27017
MONGO_DB=dedup

QDRANT_URL=http://localhost:6333

STORAGE_DIR=data/images

MODEL_PATH=dedup_model/sscd_disc_mixup.torchscript.pt
TORCH_THREADS=0

DUPLICATE_THRESHOLD=0.75
MAX_DUPLICATES_PER_IMAGE=50

MAX_FILE_BYTES=10485760
MAX_FILES_PER_REQUEST=50

WORKER_BATCH_SIZE=64
WORKER_IDLE_SLEEP=0.5
WORKER_LEASE_SECONDS=300
